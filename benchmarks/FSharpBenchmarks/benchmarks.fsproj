<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <Optimize>true</Optimize>
    <Configuration>Release</Configuration>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Config.fs" />
    <Compile Include="Agents.fs" />
    <Compile Include="PostReceiveBenchmarks.fs" />
    <Compile Include="ThroughputBenchmarks.fs" />
    <Compile Include="ReplyBenchmarks.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TaskMailbox\TaskMailbox.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Compare against the current FSharp.Core MailboxProcessor, as the tests do -->
    <PackageReference Include="FSharp.Core" VersionOverride="10.0.103" />
  </ItemGroup>
</Project>
