<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <Title>TaskMailbox</Title>
    <Description>A task-native F# MailboxProcessor built on IcedTasks CancellableTask and System.Threading.Channels</Description>
    <RepositoryUrl>https://github.com/Alterna-Dev-Studio/TaskMailbox</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Alterna-Dev-Studio/TaskMailbox</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="TaskMailboxProcessor.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="IcedTasks" />
  </ItemGroup>
</Project>
